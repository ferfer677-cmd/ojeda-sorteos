{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "CLAUDE.md",
      "firestore.rules",
      "storage.rules",
      "**/.*",
      "**/node_modules/**",
      "bocetos/**",
      "functions/**",
      "META-ADS.md"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
