{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "CLAUDE.md",
      "firestore.rules",
      "storage.rules",
      "**/.*",
      "**/node_modules/**",
      "bocetos/**",
      "functions/**",
      "META-ADS.md"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/3x1",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/3x1",
        "destination": "/3x1.html"
      },
      {
        "source": "/api/mi-ip",
        "function": {
          "functionId": "miIp",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/buscar",
        "function": {
          "functionId": "buscarComprobantes",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/ruleta",
        "function": {
          "functionId": "ruleta",
          "region": "southamerica-east1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
